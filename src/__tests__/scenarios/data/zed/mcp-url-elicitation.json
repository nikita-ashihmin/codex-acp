[
  {
    "direction": "response",
    "method": "initialize",
    "params": {
      "protocolVersion": 1,
      "agentInfo": {
        "name": "@agentclientprotocol/codex-acp",
        "title": "Codex",
        "version": "<version>"
      },
      "agentCapabilities": {
        "auth": {
          "logout": {}
        },
        "providers": {},
        "loadSession": true,
        "promptCapabilities": {
          "embeddedContext": true,
          "image": true
        },
        "sessionCapabilities": {
          "resume": {},
          "list": {},
          "close": {},
          "delete": {},
          "fork": {},
          "additionalDirectories": {},
          "subagents": {}
        },
        "mcpCapabilities": {
          "acp": false,
          "http": true,
          "sse": false
        },
        "_meta": {
          "authStatus": {}
        }
      },
      "authMethods": [
        {
          "id": "api-key",
          "name": "API Key",
          "description": "Use an API key to authenticate",
          "_meta": {
            "api-key": {
              "provider": "openai"
            }
          }
        },
        {
          "id": "chat-gpt",
          "name": "ChatGPT",
          "description": "Use ChatGPT to authenticate"
        }
      ],
      "_meta": {
        "steering": {
          "supported": true
        }
      }
    }
  },
  {
    "direction": "response",
    "method": "session/new",
    "params": {
      "sessionId": "session-1",
      "modes": {
        "availableModes": [
          {
            "id": "read-only",
            "name": "Ask for approval",
            "description": "Always ask to edit external files and use the internet"
          },
          {
            "id": "agent",
            "name": "Approve for me",
            "description": "Only ask for actions detected as potentially unsafe"
          },
          {
            "id": "agent-full-access",
            "name": "Full access",
            "description": "Unrestricted access to the internet and any file on your computer"
          }
        ],
        "currentModeId": "agent"
      },
      "configOptions": [
        {
          "id": "mode",
          "name": "Mode",
          "description": "Approval and sandboxing preset for the session",
          "category": "mode",
          "type": "select",
          "currentValue": "agent",
          "options": [
            {
              "value": "read-only",
              "name": "Ask for approval",
              "description": "Always ask to edit external files and use the internet"
            },
            {
              "value": "agent",
              "name": "Approve for me",
              "description": "Only ask for actions detected as potentially unsafe"
            },
            {
              "value": "agent-full-access",
              "name": "Full access",
              "description": "Unrestricted access to the internet and any file on your computer"
            }
          ]
        },
        {
          "id": "collaboration_mode",
          "name": "Collaboration mode",
          "description": "How Codex collaborates for subsequent turns",
          "category": "collaboration_mode",
          "type": "select",
          "currentValue": "default",
          "options": [
            {
              "value": "default",
              "name": "Default"
            },
            {
              "value": "plan",
              "name": "Plan",
              "description": "Plan before making changes"
            }
          ]
        },
        {
          "id": "model",
          "name": "Model",
          "description": "Model Codex uses for the session",
          "category": "model",
          "type": "select",
          "currentValue": "model-id",
          "options": [
            {
              "value": "model-id",
              "name": "model-id",
              "description": "model-id model"
            }
          ]
        },
        {
          "id": "reasoning_effort",
          "name": "Reasoning effort",
          "description": "How much reasoning effort the model should use",
          "category": "thought_level",
          "type": "select",
          "currentValue": "medium",
          "options": [
            {
              "value": "medium",
              "name": "Medium",
              "description": "Balanced"
            }
          ]
        }
      ]
    }
  },
  {
    "direction": "request",
    "method": "session/request_permission",
    "params": {
      "sessionId": "session-1",
      "toolCall": {
        "toolCallId": "elicitation-el-1",
        "kind": "fetch",
        "status": "pending",
        "title": "MCP server requests to open a URL",
        "rawInput": {
          "serverName": "docs",
          "description": "Sign in to the docs server",
          "url": "https://example.com/login"
        },
        "content": [
          {
            "type": "content",
            "content": {
              "type": "text",
              "text": "Sign in to the docs server"
            }
          }
        ]
      },
      "options": [
        {
          "optionId": "accept",
          "name": "Allow",
          "kind": "allow_once"
        },
        {
          "optionId": "decline",
          "name": "Deny",
          "kind": "reject_once"
        },
        {
          "optionId": "cancel",
          "name": "Cancel",
          "kind": "reject_once"
        }
      ]
    }
  },
  {
    "direction": "notify",
    "method": "session/update",
    "params": {
      "sessionId": "session-1",
      "update": {
        "sessionUpdate": "tool_call_update",
        "toolCallId": "elicitation-el-1",
        "status": "completed",
        "rawOutput": {
          "action": "accept"
        }
      }
    }
  },
  {
    "direction": "codexResponse",
    "method": "mcpServer/elicitation/request",
    "params": {
      "action": "accept",
      "content": null,
      "_meta": null
    }
  },
  {
    "direction": "notify",
    "method": "session/update",
    "params": {
      "sessionId": "session-1",
      "update": {
        "sessionUpdate": "session_info_update",
        "title": "Go"
      }
    }
  },
  {
    "direction": "response",
    "method": "session/prompt",
    "params": {
      "stopReason": "end_turn",
      "usage": null,
      "_meta": {
        "quota": {
          "token_count": null,
          "model_usage": []
        }
      }
    }
  }
]
