              "jetbrains": {
                "air": {
                  "version": 1,
                  "kind": "standard"
                }
              }
            }
          },
          {
            "id": "agent",
            "name": "Approve for me",
            "description": "Only ask for actions detected as potentially unsafe",
            "_meta": {
              "jetbrains": {
                "air": {
                  "version": 1,
                  "kind": "auto_review"
                }
              }
            }
          },
          {
            "id": "agent-full-access",
            "name": "Full access",
            "description": "Unrestricted access to the internet and any file on your computer",
            "_meta": {
              "jetbrains": {
                "air": {
                  "version": 1,
                  "kind": "full_access"
                }
              }
            }
          }
        ],
        "currentModeId": "agent"
      },
      "configOptions": [
        {
          "id": "mode",
          "name": "Mode",
          "description": "Approval and sandboxing preset for the session",
          "category": "mode",
          "type": "select",
          "currentValue": "agent",
          "options": [
            {
              "value": "read-only",
              "name": "Ask for approval",
              "description": "Always ask to edit external files and use the internet",
              "_meta": {
                "jetbrains": {
                  "air": {
                    "version": 1,
                    "kind": "standard"
                  }
                }
              }
            },
            {
              "value": "agent",
              "name": "Approve for me",
              "description": "Only ask for actions detected as potentially unsafe",
              "_meta": {
                "jetbrains": {
                  "air": {
                    "version": 1,
                    "kind": "auto_review"
                  }
                }
              }
            },
            {
              "value": "agent-full-access",
              "name": "Full access",
              "description": "Unrestricted access to the internet and any file on your computer",
              "_meta": {
                "jetbrains": {
                  "air": {
                    "version": 1,
                    "kind": "full_access"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "collaboration_mode",
          "name": "Collaboration mode",
          "description": "How Codex collaborates for subsequent turns",
          "category": "collaboration_mode",
          "type": "select",
          "currentValue": "default",
          "options": [
            {
              "value": "default",
              "name": "Default"
            },
            {
              "value": "plan",
              "name": "Plan",
              "description": "Plan before making changes"
            }
          ]
        },
        {
          "id": "model",
          "name": "Model",
          "description": "Model Codex uses for the session",
          "category": "model",
          "type": "select",
          "currentValue": "model-id",
          "options": [
            {
              "value": "model-id",
              "name": "model-id",
              "description": "model-id model"
            }
          ],
          "_meta": {
            "jetbrains": {
              "air": {
                "version": 1,
                "recommendedValue": "model-id"
              }
            }
          }
        },
        {
          "id": "reasoning_effort",
          "name": "Reasoning effort",
          "description": "How much reasoning effort the model should use",
          "category": "thought_level",
          "type": "select",
          "currentValue": "medium",
          "options": [
            {
              "value": "medium",
              "name": "Medium",
              "description": "Balanced"
            }
          ],
          "_meta": {
            "jetbrains": {
              "air": {
                "version": 1,
                "recommendedValue": "medium"
              }
            }
          }
        }
      ]
    }
  },
  {
    "direction": "notify",
    "method": "session/update",
    "params": {
      "sessionId": "session-1",
      "update": {
        "sessionUpdate": "tool_call",
        "toolCallId": "cmd-a",
        "kind": "execute",
        "title": "npm install",
        "status": "in_progress",
        "content": [
          {
            "type": "terminal",
            "terminalId": "cmd-a"
          }
        ],
        "rawInput": {
          "command": "npm install",
          "cwd": "/workspace"
        },
        "_meta": {
          "terminal_info": {
            "cwd": "/workspace",
            "terminal_id": "cmd-a"
          }
        }
      }
    }
  },
  {
    "direction": "request",
    "method": "session/request_permission",
    "params": {
      "sessionId": "session-1",
      "toolCall": {
        "toolCallId": "cmd-a",
        "title": "npm install",
        "rawInput": {
          "command": "npm install",
          "cwd": "/workspace"
        }
      },
      "options": [
        {
          "optionId": "allow_once",
          "name": "Yes, proceed",
          "kind": "allow_once"
        },
        {
          "optionId": "allow_for_session",
          "name": "Yes, and don't ask again for this command in this session",
          "kind": "allow_always"
        },
        {
          "optionId": "decline",
          "name": "No, continue without running it",
          "kind": "reject_once"
        },
        {
          "optionId": "cancel",
          "name": "No, and tell Codex what to do differently",
          "kind": "reject_once"
        }
      ],
      "_meta": {
        "jetbrains": {
          "air": {
            "version": 1,
            "permission": {
              "version": 1,
              "title": "Run command?",
              "description": "Install the dependencies."
            }
          }
        }
      }
    }
  },
  {
    "direction": "codexResponse",
    "method": "item/commandExecution/requestApproval",
    "params": {
      "decision": "accept"
    }
  },
  {
    "direction": "notify",
    "method": "session/update",
    "params": {
      "sessionId": "session-1",
      "update": {
        "sessionUpdate": "tool_call_update",
        "toolCallId": "cmd-a",
        "status": "completed",
        "_meta": {
          "terminal_output_delta": {
            "data": "added 1 package\n",
            "terminal_id": "cmd-a"
          },
          "terminal_exit": {
            "exit_code": 0,
            "signal": null,
            "terminal_id": "cmd-a"
          }
        }
      }
    }
  },
  {
    "direction": "notify",
    "method": "session/update",
    "params": {
      "sessionId": "session-1",
      "update": {
        "sessionUpdate": "session_info_update",
        "title": "Go"
      }
    }
  },
  {
    "direction": "response",
    "method": "session/prompt",
    "params": {
      "stopReason": "end_turn",
      "usage": null,
      "_meta": {
        "quota": {
          "token_count": null,
          "model_usage": []
        }
      }
    }
  }
]
