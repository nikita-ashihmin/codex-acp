            "api-key": {
              "provider": "openai"
            }
          }
        },
        {
          "id": "chat-gpt",
          "name": "ChatGPT",
          "description": "Use ChatGPT to authenticate"
        },
        {
          "id": "chat-gpt-device-code",
          "name": "ChatGPT (device code)",
          "description": "Sign in to ChatGPT by opening a verification page and entering a one-time code"
        }
      ],
      "_meta": {
        "steering": {
          "supported": true
        },
