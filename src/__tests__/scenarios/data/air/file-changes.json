        "title": "Codex",
        "version": "<version>"
      },
      "agentCapabilities": {
        "auth": {
          "logout": {}
        },
        "providers": {},
        "loadSession": true,
        "promptCapabilities": {
          "embeddedContext": true,
          "image": true
        },
        "sessionCapabilities": {
          "resume": {},
          "list": {},
          "close": {},
          "delete": {},
          "fork": {},
