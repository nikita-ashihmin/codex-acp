        "sessionUpdate": "tool_call",
        "toolCallId": "fc-add",
        "kind": "edit",
        "title": "Editing files",
        "status": "in_progress",
        "content": [
          {
            "type": "diff",
            "oldText": null,
            "newText": "",
            "path": "/workspace/new.txt",
