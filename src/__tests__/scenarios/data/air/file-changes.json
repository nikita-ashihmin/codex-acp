              "kind": "add",
              "jetbrains": {
                "air": {
                  "version": 1,
                  "diffPatch": {
                    "version": 1,
                    "format": "git_patch",
                    "text": "diff --git a/workspace/new.txt b/workspace/new.txt\nnew file mode 100644\n--- /dev/null\n+++ b/workspace/new.txt\n@@ -0,0 +1,2 @@\n+hello\n+world\n"
                  }
                }
              }
            }
          }
        ]
      }
    }
